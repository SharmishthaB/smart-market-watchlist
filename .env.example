# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=groww_user
DB_PASSWORD=groww_password
DB_NAME=smart_watchlist
# Or use full connection string:
DATABASE_URL=postgresql://groww_user:groww_password@localhost:5432/smart_watchlist

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_code_groww_2026_production_ready_hash
JWT_EXPIRES_IN=7d

# Market Data API (Finnhub.io)
# Free API key from https://finnhub.io
FINNHUB_API_KEY=

# Application Settings
WATCHLIST_MAX_ITEMS=50
FETCH_INTERVAL_MARKET_OPEN_SEC=15
FETCH_INTERVAL_MARKET_CLOSED_SEC=300
CACHE_TTL_SEC=30
